#!/usr/bin/env node
'use strict';

// Blastgate plugin entrypoint (U14).
//
// A thin, real shim over the shared engine CLI (KTD10/KTD12) — it does NOT
// re-implement any logic. Every plugin surface execs this:
//
//   blastgate check --gate <phase>   PreToolUse deny / PostToolUse block (enforcement)
//   blastgate check --since <ref>    the /blastgate slash-command scan
//   blastgate mcp                    the blastgate_check_change stdio server (ergonomics)
//
// It forwards argv, stdin, stdout, stderr, and exit code straight through to the
// real `blastgate` CLI, so the deny/block JSON the hooks read and the hook JSON on
// stdin flow unchanged. The pre-commit hook is the load-bearing gate; a blocked
// change proceeds only via the auditable .blastgate/acknowledged.json override,
// never by silently disabling the gate here.

const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');

const args = process.argv.slice(2);

// Resolve the engine CLI: the co-located build when developing/dogfooding in the
// Blastgate repo (plugin/ is a sibling of dist/), else the published npm package.
function resolveEngine() {
  const local = path.resolve(__dirname, '..', '..', 'dist', 'cli', 'index.js');
  if (fs.existsSync(local)) {
    return { cmd: process.execPath, base: [local] };
  }
  return { cmd: 'npx', base: ['-y', 'blastgate'] };
}

const { cmd, base } = resolveEngine();
const result = spawnSync(cmd, [...base, ...args], { stdio: 'inherit', env: process.env });

if (result.error) {
  // Never SILENTLY disable the gate: surface the failure loudly and exit non-zero
  // (a non-block error the user sees), rather than allowing quietly.
  process.stderr.write(
    `blastgate: could not run the engine (${result.error.message}). ` +
      `Install it (\`npm i -g blastgate\`) or build it in the repo.\n`,
  );
  process.exit(1);
}

process.exit(result.status == null ? 1 : result.status);
